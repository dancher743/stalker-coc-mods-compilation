--
-- Spots for mines
-- By Dancher
--

local function has_spot(id)
	return level.map_has_object_spot(id, "mine_actor_spot") == 1
end

function add_spot(id)
	level.map_add_object_spot_ser(id, "mine_actor_spot", strtransl("st_wpn_mine_name"))
end

local function remove_spot(id)
	if (has_spot(id) == false) then
		return
	end
	
	local se_obj = alife_object(id)
	
	if (se_obj == nil) then
		printf("A-life object of mine is not found.")
		return
	end
	
	local mine_pos = se_obj.position
	local actor_pos = db.actor:position()
	local defuse_radius = m_mines.DEFUSE_RADIUS
	
	if (mine_pos:distance_to_sqr(actor_pos) >= defuse_radius * defuse_radius) then
		local hud = get_hud()
		if (hud) then
			hud:HidePdaMenu()
			SetHudMsg(strtransl("st_mine_actor_too_far_to_remove_hudmsg"),5)
		end
		return
	end
	
	local obj = level.object_by_id(se_obj.id)
	m_mines.remove_actor_mine(obj)
end

local function map_spot_menu_add_property(property_ui,id,level_name)
	if (has_spot(id) == false) then
		return
	end
	
	property_ui:AddItem(strtransl("ui_st_mine_actor_spot_remove"))
end

local function map_spot_menu_property_clicked(property_ui,id,level_name,prop)
	if (prop ~= strtransl("ui_st_mine_actor_spot_remove")) then
		return
	end
	
	remove_spot(id)
end

function on_game_start()
	RegisterScriptCallback("map_spot_menu_add_property", map_spot_menu_add_property)
	RegisterScriptCallback("map_spot_menu_property_clicked", map_spot_menu_property_clicked)
end
