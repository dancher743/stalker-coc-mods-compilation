local light_zones = {}

local indoor_levels = {
	labx8				 	= true,
	jupiter_underground 	= true,

	-- Call of Chernobyl
	l03u_agr_underground 	= true,
	l04u_labx18 			= true,
	l08u_brainlab 			= true,
	l10u_bunker 			= true,
	l12u_sarcofag 			= true,
	l12u_control_monolith 	= true,
	l13u_warlab 			= true
}

---------------------------------------------------------------------------------------------------------------------
class "action_light"
function action_light:__init (obj, storage)
	self.object = obj
	self.st = storage
	self.active = false
	self.id = obj:id()
end
function action_light:reset_scheme()
	light_zones[self.id] = self
end
function action_light:update(delta)
	if xr_logic.try_switch_to_another_section(self.object, self.st, db.actor) then
		self.active = false
		light_zones[self.id] = nil
		return
	end
	self.active = true
end
function action_light:check_stalker(stalker)
    if self.active == false then
       return false, false
    end

	if self.object:inside(stalker:position()) then
		return self.st.light, true
	end

	return false, false
end

---------------------------------------------------------------------------------------------------------------------
function add_to_binder(npc, ini, scheme, section, storage)
--'	printf("DEBUG: add_to_binder: scheme='%s', section='%s'", scheme, section)
	local new_action = action_light (npc, storage)
	xr_logic.subscribe_action_for_events(npc, storage, new_action)
end

function set_scheme(npc, ini, scheme, section, gulag_name)
	local st = xr_logic.assign_storage_and_bind(npc, ini, scheme, section)
	st.logic = xr_logic.cfg_get_switch_conditions(ini, section, npc)
	st.light = ini:r_bool_ex(section,"light_on",false)
end



---------------------------------------------------------------------------------------------------------------------
function check_light(stalker)

	local st = db.storage[stalker:id()]
	local tg = time_global()

	if (st.srlight_timer and tg < st.srlight_timer) then
		return
	end
	
	local random_value = math.random(100)
	
	st.srlight_timer = tg + 2000 + random_value

    local torch = stalker:object("device_torch")
	local should_zombie_ignore_torch = 50 >= random_value
	local ignore_torch_flag = st.ignore_torch_flag

	-- Stalker dead or sleep animstate; release torch
	local anm = state_mgr.get_state(stalker)
	if (not stalker:alive() or anm == "zat_b106_wounded_idle" or anm == "sleep" or anm == "play_guitar" or string.find(anm,"animpoint") or string.find(anm,"sneak")) then
		if (torch) then
			if (torch:attachable_item_enabled()) then
				torch:enable_attachable_item(false)
			end
			local sim = alife()
			local se_torch = sim:object(torch:id())
			if se_torch then
				sim:release(se_torch,true)
			end
		end
		return
	end

	-- Stalker in danger mode; release torch
	if (st.danger_flag) then
		if(not ignore_torch_flag and stalker:character_community() == "zombied" and should_zombie_ignore_torch) then
			st.ignore_torch_flag = true
		end
	
		if (torch and not st.ignore_torch_flag) then
			if (torch:attachable_item_enabled()) then
				torch:enable_attachable_item(false)
			end
			local sim = alife()
			local se_torch = sim:object(torch:id())
			if se_torch then
				sim:release(se_torch,true)
			end
		end
		return
	end

	-- Stalker is companion; disable torch
	if (axr_companions.is_companion(stalker)) then
		if (xr_conditions.is_night() or xr_conditions.is_heavy_rain()) then
			local actor_torch = db.actor:object("device_torch")
			if (actor_torch and not actor_torch:torch_enabled()) then
				if (torch) then
					torch:enable_attachable_item(false)
				end
				return
			end
		end
	end

	-- Non-headlamp scheme in use; release torch
	local scheme = st.active_scheme
	if (scheme == "kamp" or scheme == "camper" or scheme == "sleeper") then
		if (torch) then
			if (torch:attachable_item_enabled()) then
				torch:enable_attachable_item(false)
			end
			local sim = alife()
			local se_torch = sim:object(torch:id())
			if se_torch then
				sim:release(se_torch,true)
			end
		end
		return
	end

	-- Stalker has enemy and is not underground; release torch
	if (stalker:best_enemy() and not indoor_levels[level.name()]) then
		if(not ignore_torch_flag and stalker:character_community() == "zombied" and should_zombie_ignore_torch) then
			st.ignore_torch_flag = true
		end
		
		if (torch and not st.ignore_torch_flag) then
			if (torch:attachable_item_enabled()) then
				torch:enable_attachable_item(false)
			end
			local sim = alife()
			local se_torch = sim:object(torch:id())
			if se_torch then
				sim:release(se_torch,true)
			end
		end
		return
	end

	local forced, light = false, false

	for k,v in pairs(light_zones) do
		light, forced = v:check_stalker(stalker)
		if forced == true then
			break
		end
	end

	if not forced then
		if xr_conditions.is_night() then
			light = true
		end

		if light == false then
			if indoor_levels[level.name()] == true then
				light = true
			end
		end
	end

	if (light) then
		if (torch) then
			if not (torch:attachable_item_enabled()) then
				torch:enable_attachable_item(true)
			end
		else
			local sim = alife()
			sim:create("device_torch", VEC_ZERO, 0, 0, stalker:id())
		end
		st.ignore_torch_flag = false
	else
		if (torch) then
			if (torch:attachable_item_enabled()) then
				torch:enable_attachable_item(false)
			end
			local sim = alife()
			local se_torch = sim:object(torch:id())
			if se_torch then
				sim:release(se_torch,true)
			end
		end
	end
end

local function check_victim_light(stalker, victim)
	if (stalker:relation(victim) ~= game_object.enemy) then
		return
	end
	
	if not (xr_conditions.is_night() or xr_conditions.is_heavy_rain()) then
		return
	end

	local torch = victim:object("device_torch")
	if not (torch and torch:torch_enabled()) then
		return
    end
	
	local victim_pos = victim:position()
	local stalker_pos = stalker:position()
	local distance_sqr = stalker_pos:distance_to_sqr(victim_pos)
	local eye_range = utils.stalker_eye_range(stalker)

	if (distance_sqr < eye_range * eye_range) then
		local dir_to_victim = vector():sub(victim_pos, stalker_pos)
		dir_to_victim:normalize()
		local cos_alpha = stalker:direction():dotproduct(dir_to_victim)

		-- 0.707 is 90 degrees
		if (cos_alpha > 0.707) then
			stalker:make_object_visible_somewhen(victim)
		end
	end
end

function check_actor_light(stalker)
	local actor = db.actor

	if (xr_combat_ignore.fighting_with_actor_npcs[stalker:id()] == true) then
		return
	end
	
	check_victim_light(stalker, actor)
end

function check_actor_companions_light(stalker)
	local function callback(k)
		local member = db.storage[k.id] and db.storage[k.id].object
		
		if (member) then
			check_victim_light(stalker, member)
		end
	end
	
	axr_companions.iterate_actor_squad(callback)
end

function clean_up ()
	for k,v in pairs(light_zones) do
		light_zones[k] = nil
	end
end
