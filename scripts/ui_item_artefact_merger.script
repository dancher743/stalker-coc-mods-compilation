--
-- Artifact Merger item UI
-- Copy-past of ui_itm_repair by Alundaio
--

-------------------------------------------------------------------
class "load_item" (CUIListBoxItem)
function load_item:__init(height) super(height)
	self.file_name		= "filename"

	self:SetTextColor(GetARGB(255, 170, 170, 170))

	self.fn = self:GetTextItem()
	self.fn:SetFont(GetFontLetterica18Russian())
	self.fn:SetEllipsis(true)
end

function load_item:__finalize()
end

-------------------------------------------------------------------
class "artefact_merger_ui" (CUIScriptWnd)

function artefact_merger_ui:__init(owner) super()
	self.owner = owner
	self.ini = system_ini()
	self.combinations = {}
	self.actor_artefacts = nil
	self.closest_anomaly, self.closest_anomaly_meters = self:GetClosestAnomaly()

	self:InitCombinationsTable()
	self:InitControls()
	self:InitCallBacks()

	SetHudMsg(STR_EMPTY,0)
end

function artefact_merger_ui:__finalize()
end

function artefact_merger_ui:InitCombinationsTable()
	local ini = ini_file("plugins\\artefact_merger_combinations.ltx")
	local combinations_names = utils.parse_ini_section_to_iarray(ini,"combinations") or {}
	
	for _,combination_name in ipairs(combinations_names) do
		self.combinations[combination_name] = {
			["need"] = tonumber(ini:r_string_ex(combination_name,"need")),
			["result"] = ini:r_string_ex(combination_name,"result") 
		}
	end
end

function artefact_merger_ui:InitControls()
	self:SetWndRect			(Frect():set(0,0,1024,768))

	self:SetAutoDelete(true)

	self.xml				= CScriptXmlInit()
	local ctrl
	self.xml:ParseFile			("ui_item_artefact_merger.xml")

	ctrl					= CUIWindow()
	ctrl:SetAutoDelete(true)
	self.xml:InitWindow			("itm_repair:file_item:main",0,ctrl)
	
	self.file_item_main_sz	= vector2():set(ctrl:GetWidth(),ctrl:GetHeight())

	self.xml:InitWindow			("itm_repair:file_item:fn",0,ctrl)
	self.file_item_fn_sz	= vector2():set(ctrl:GetWidth(),ctrl:GetHeight())

	self.xml:InitWindow			("itm_repair:file_item:fd",0,ctrl)
	self.file_item_fd_sz	= vector2():set(ctrl:GetWidth(),ctrl:GetHeight())

	self.form				= self.xml:InitStatic("itm_repair:form",self)
	--background window
	self.xml:InitFrame			("itm_repair:form:frame",self.form)
	--self.form:SetWndPos(vector2():set(device().width/2-(self.form:GetWidth()+70), device().height/2 - self.form:GetHeight()))
	self.form:SetWndPos(vector2():set(0, 0))

	-- Background for forms
	--self.xml:InitStatic("itm_repair:form:list_background",self.form)

	-- Item picture
	self.picture			= self.xml:InitStatic("itm_repair:form:icon",self.form)
	self.picture_parts		= self.xml:InitStatic("itm_repair:form:icon_parts",self.form)
	self.picture_result		= self.xml:InitStatic("itm_repair:form:icon_result",self.form)

	-- Repair tool picture
	self.pic = self.xml:InitStatic("itm_repair:form:icon_tool",self.form)

	local section = "artefact_merger"
	local inv_grid_width = self.ini:r_float_ex(section,"inv_grid_width") or 0 
	local inv_grid_height = self.ini:r_float_ex(section,"inv_grid_height") or 0
	local inv_grid_x = self.ini:r_float_ex(section,"inv_grid_x") or 0
	local inv_grid_y = self.ini:r_float_ex(section,"inv_grid_y") or 0

	local x1 = inv_grid_x*50
	local y1 = inv_grid_y*50

	local w = inv_grid_width*50
	local h = inv_grid_height*50

	local x2 = x1 + w
	local y2 = y1 + h

	local w,h = w,h
	if (utils.is_widescreen()) then
	w,h = w/1.5,h/1.2
	else
	w,h = w/1.3,h/1.3
	end
	self.pic:InitTexture("ui\\ui_icon_equipment")
	self.pic:SetTextureRect(Frect():set(x1,y1,x2,y2))
	self.pic:SetWndSize(vector2():set(w,h))

	if not (self.pic.x) then
		local pos = self.pic:GetWndPos()
		local posform = self.form:GetWndPos()
		self.pic.x = pos.x + posform.x
		self.pic.y = pos.y + posform.y
	end

	self.pic:SetWndPos(vector2():set(self.pic.x-w/2, self.pic.y-h/2))

	-- Caption Text
	self.caption_repair_text = strtransl("ui_st_available_artefacts")
	self.caption_parts_text = STR_EMPTY

	-- Caption Color
	 self.caption_parts_text_color = GetARGB(255,255,255,255)
	 self.caption_has_parts_text_color = GetARGB(255,200,200,50)

	-- Caption
	self.caption_repair		= self.xml:InitTextWnd("itm_repair:form:caption_repair",self.form)
	self.caption_repair:SetText(self.caption_repair_text)
	self.caption_parts 		= self.xml:InitTextWnd("itm_repair:form:caption_parts",self.form)
	self.caption_parts:SetText(self.caption_parts_text)
	self.caption_anomaly_zone 		= self.xml:InitTextWnd("itm_repair:form:caption_anomaly_zone",self.form)
	self.caption_anomaly_zone:SetText(STR_EMPTY)

	-- List Box
	self.xml:InitFrame			("itm_repair:form:list_frame",self.form)

	self.list_box			= self.xml:InitListBox("itm_repair:form:list",self.form)

	self.list_box:ShowSelectedItem	(true)
	self:Register			(self.list_box, "list_window")

	-- Parts List Box
	self.list_pos = self.list_box:GetWndPos()
	
	self.list_box_parts			= self.xml:InitListBox("itm_repair:form:list_parts",self.form)
	--self.list_box_parts:SetWndPos(vector2():set(self.list_pos.x+self.list_box:GetWidth()+5, self.list_pos.y))
	
	local frame = self.xml:InitFrame("itm_repair:form:list_frame_parts",self.form)
	--frame:SetWndPos(vector2():set(self.list_pos.x+self.list_box:GetWidth()+5, self.list_pos.y))
	
	self.list_box_parts:ShowSelectedItem(true)
	self:Register(self.list_box_parts, "list_window_parts")

	-- Button Repair
	ctrl					= self.xml:Init3tButton("itm_repair:form:btn_repair",	self.form)
	self:Register			(ctrl, "button_repair")

	-- Button Cancel
	ctrl = self.xml:Init3tButton	("itm_repair:form:btn_cancel",	self.form)
	self:Register			(ctrl, "button_back")
end

function artefact_merger_ui:InitCallBacks()
	self:AddCallback("button_repair",		ui_events.BUTTON_CLICKED,         self.OnButton_repair,			self)
	self:AddCallback("button_back",		ui_events.BUTTON_CLICKED,             self.OnButton_back_clicked,	self)

	self:AddCallback("list_window", ui_events.LIST_ITEM_CLICKED, 			  self.OnListItemClicked,		self)
	self:AddCallback("list_window", ui_events.WINDOW_LBUTTON_DB_CLICK,		  self.OnListItemDbClicked,		self)

	self:AddCallback("list_window_parts", ui_events.LIST_ITEM_CLICKED, 		  self.OnPartsListItemClicked,		self)
	self:AddCallback("list_window_parts", ui_events.WINDOW_LBUTTON_DB_CLICK,  self.OnPartsListItemDbClicked,	self)
end

function artefact_merger_ui:FillList()
	self.list_box:RemoveAll()

	self.actor_artefacts = {}

	local function fill_list(actor,obj)
		if (obj and IsArtefact(obj)) then
			local section = obj:section()

			if (self.combinations[section] == nil) then
				return
			end

			local artefacts = self.actor_artefacts[section]
			if (artefacts == nil) then
				 artefacts = {}
				 self.actor_artefacts[section] = artefacts
			end
			table.insert(artefacts, obj)

			if (#artefacts > 1) then
				return
			end

			self:AddItemToList(obj,self.list_box)
		end
	end

	db.actor:iterate_inventory(fill_list,db.actor)
end

function artefact_merger_ui:FillPartsList()
	self.list_box_parts:RemoveAll()

	if self.list_box:GetSize()==0 then return end

	local item = self.list_box:GetSelectedItem()
	if not (item) then
		return
	end

	local obj = level.object_by_id(item.item_id)
	if (obj == nil) then
		self.list_box_parts:RemoveItem(item)
		return
	end

	if (self.combinations[obj:section()] == nil) then
		return
	end

	self:AddItemToList(obj,self.list_box_parts)
end

function artefact_merger_ui:OnPartsListItemClicked()
	if self.list_box_parts:GetSize()==0 then return end

	local item = self.list_box_parts:GetSelectedItem()
	if not (item) then
		self.picture_parts:SetTextureRect(Frect():set(0,0,0,0))
		self.picture_result:SetTextureRect(Frect():set(0,0,0,0))
		self.caption_parts:SetText(self.caption_parts_text)
		self.caption_anomaly_zone:SetText(STR_EMPTY)
		return
	end

	local se_item = item.item_id and alife_object(item.item_id)
	if (se_item == nil or not db.actor:object(se_item:section_name())) then
		self.list_box_parts:RemoveItem(item)
		return
	end

	local item_section = se_item:section_name()
	local result_section = self.combinations[item_section]["result"]
	local result_text = strtransl("ui_st_total_artefacts")
	local item_name = strtransl(news_manager.get_inv_name(item_section))
	local amount = self.combinations[item_section]["need"]
	local result_name = strtransl(news_manager.get_inv_name(result_section))
	local text = strformat("%s: %s x%s = %s x1", result_text, item_name, amount, result_name)
	self.caption_parts:SetText(text)

	local color = #self.actor_artefacts[item_section] >= amount and self.caption_has_parts_text_color or self.caption_parts_text_color
	self.caption_parts:SetTextColor(color)
	
	local anomaly_text = STR_EMPTY
	local anomaly_text_color = self.caption_parts_text_color

	if (self.closest_anomaly) then
		anomaly_text = strformat("%s: %sm", strtransl("ui_st_closest_anomaly_zone"), math.floor(self.closest_anomaly_meters))
		anomaly_text_color = self.caption_has_parts_text_color
	else
		if (self.closest_anomaly_meters) then
			anomaly_text = strformat("%s: %sm", strtransl("ui_st_closest_anomaly_zone"), math.floor(self.closest_anomaly_meters))
		else
			anomaly_text = strformat("%s: --", strtransl("ui_st_closest_anomaly_zone"))
		end
	end

	self.caption_anomaly_zone:SetText(anomaly_text)
	self.caption_anomaly_zone:SetTextColor(anomaly_text_color)

	local w,h = item.width,item.height
	if (utils.is_widescreen()) then
	w,h = item.width/1.5,item.height/1.2
	else
	w,h = item.width/1.2,item.height/1.2
	end
	self.picture_parts:InitTexture("ui\\ui_icon_equipment")
	self.picture_parts:SetTextureRect(Frect():set(item.x1,item.y1,item.x2,item.y2))
	self.picture_parts:SetWndSize(vector2():set(w,h))

	if not (self.picture_parts.x) then
		local pos = self.picture_parts:GetWndPos()
		self.picture_parts.x = pos.x
		self.picture_parts.y = pos.y
	end
	
	local x1 = (self.ini:r_float_ex(result_section,"inv_grid_x") or 0) * 50
	local y1 = (self.ini:r_float_ex(result_section,"inv_grid_y") or 0) * 50
	local x2 = x1 + 50
	local y2 = y1 + 50
	self.picture_result:InitTexture("ui\\ui_icon_equipment")
	self.picture_result:SetTextureRect(Frect():set(x1,y1,x2,y2))
	self.picture_result:SetWndSize(vector2():set(w,h))
	
	if not (self.picture_result.x) then
		local pos = self.picture_result:GetWndPos()
		self.picture_result.x = pos.x
		self.picture_result.y = pos.y
	end

	self.picture_parts:SetWndPos(vector2():set(self.picture_parts.x-w/2, self.picture_parts.y-h/2))
	self.picture_result:SetWndPos(vector2():set(self.picture_result.x-w/2, self.picture_result.y-h/2))
end

function artefact_merger_ui:OnPartsListItemDbClicked()
	self:OnButton_repair()
end

function artefact_merger_ui:OnListItemClicked()
	if self.list_box:GetSize()==0 then return end

	local item = self.list_box:GetSelectedItem()

	if not (item) then
		self.picture:SetTextureRect(Frect():set(0,0,0,0))
		return
	end

	local se_item = alife_object(item.item_id)
	if (se_item == nil or not db.actor:object(se_item:section_name())) then
		self.list_box:RemoveItem(item)
		return
	end

	local w,h = item.width,item.height
	if (utils.is_widescreen()) then
	w,h = item.width/1.5,item.height/1.2
	else
	w,h = item.width/1.2,item.height/1.2
	end
	self.picture:InitTexture("ui\\ui_icon_equipment")
	self.picture:SetTextureRect(Frect():set(item.x1,item.y1,item.x2,item.y2))
	self.picture:SetWndSize(vector2():set(w,h))

	if not (self.picture.x) then
		local pos = self.picture:GetWndPos()
		self.picture.x = pos.x
		self.picture.y = pos.y
	end

	self.picture:SetWndPos(vector2():set(self.picture.x-w/2, self.picture.y-h/2))
	
	self.picture_parts:SetTextureRect(Frect():set(0,0,0,0))
	self.picture_result:SetTextureRect(Frect():set(0,0,0,0))
	self.caption_repair:SetText(self.caption_repair_text)
	self.caption_parts:SetText(self.caption_parts_text)
	self.caption_anomaly_zone:SetText(STR_EMPTY)
	self:FillPartsList()
end

function artefact_merger_ui:OnListItemDbClicked()
end

function artefact_merger_ui:OnButton_back_clicked()
	self:HideDialog()
end

function artefact_merger_ui:OnKeyboard(dik, keyboard_action)
	CUIScriptWnd.OnKeyboard(self,dik,keyboard_action)
	if (keyboard_action == ui_events.WINDOW_KEY_PRESSED) then
		if (dik == DIK_keys.DIK_RETURN) then

		elseif (dik == DIK_keys.DIK_ESCAPE) then
			self:OnButton_back_clicked()
		end
	end
	return true
end

function artefact_merger_ui:OnButton_repair()
	local item = self.list_box_parts:GetSelectedItem()
	if not (item) then
		return
	end

	local se_item = alife_object(item.item_id)
	if (se_item == nil) then
		return
	end

	local item_section = se_item:section_name()
	local amount = self.combinations[item_section]["need"]
	local artefacts = self.actor_artefacts[item_section]
	local artefacts_amount = #artefacts

	if (artefacts_amount < amount) then
		self:OnButton_back_clicked()
		SetHudMsg(strtransl("ui_st_not_enough_artefacts_to_merger"),5)
		return
	end

	local result_section = self.combinations[item_section]["result"]

	if (self:CheckClosestAnomaly(result_section) == false) then
		self:OnButton_back_clicked()
		return
	end

	for i = artefacts_amount, (artefacts_amount - amount + 1), -1 do
		local artefact_to_remove = artefacts[i]
		table.remove(artefacts, i)
		release(artefact_to_remove)
	end
	create_item(result_section, db.actor)

	xr_statistic.inc_rank("artefacts_merged")

	xr_effects.disable_actor_nightvision()
	level.add_pp_effector("teleport.ppe", 2006, false)

	local caption = strtransl("st_artefact_merger")
	local inv_nam = news_manager.get_inv_name(result_section)
	local text = strformat("%s: %s x1", strtransl("st_artefact_merge_result"), strtransl(inv_nam))
	local icon = "ui_iconsTotal_esc_blockpost_case_to_trader"
	news_helper.give_news(caption, text, icon, 600, 6000)

	SetHudMsg(STR_EMPTY,0)
	self:OnButton_back_clicked()
end

function artefact_merger_ui:AddItemToList(item,listbox,text)
	local _itm			= load_item(self.file_item_main_sz.y)
	local sec = item and item:section()
	local inv_name 		= item and game.translate_string(self.ini:r_string_ex(sec,"inv_name") or STR_NONE)

	_itm:SetWndSize		(self.file_item_main_sz)

	_itm.fn:SetWndPos(vector2():set(0,0))
	_itm.fn:SetWndSize	(self.file_item_fn_sz)
	_itm.fn:SetText		(inv_name)

	if (item) then
		if (text ~= nil) then
			_itm.fage     = _itm:AddTextField(text, self.file_item_fd_sz.x)
			_itm.fage:SetFont	(GetFontLetterica16Russian())
			_itm.fage:SetWndPos	(vector2():set(self.file_item_fn_sz.x+4, 0))
			_itm.fage:SetWndSize(self.file_item_fd_sz)
		end

		_itm.item_id = item:id()

		local inv_grid_width = self.ini:r_float_ex(sec,"inv_grid_width") or 0
		local inv_grid_height = self.ini:r_float_ex(sec,"inv_grid_height") or 0
		local inv_grid_x = self.ini:r_float_ex(sec,"inv_grid_x") or 0
		local inv_grid_y = self.ini:r_float_ex(sec,"inv_grid_y") or 0

		_itm.x1 = inv_grid_x*50
		_itm.y1 = inv_grid_y*50

		_itm.width = inv_grid_width*50
		_itm.height = inv_grid_height*50

		_itm.x2 = _itm.x1 + _itm.width
		_itm.y2 = _itm.y1 + _itm.height
	end

	listbox:AddExistingItem(_itm)
end

function artefact_merger_ui:GetClosestAnomaly()
	local actor_pos = db.actor:position()

	local scan_distance_sqr = 50 * 50
	local min_distance_sqr = scan_distance_sqr

	local closest_anomaly = nil

	for _, anomaly in pairs(db.anomaly_by_name) do
		if (anomaly.object) then
			local current_dist_sqr = anomaly.object:position():distance_to_sqr(actor_pos)
			if (current_dist_sqr < min_distance_sqr) then
				min_distance_sqr = current_dist_sqr
				closest_anomaly = anomaly
			end
		end
	end

	if (closest_anomaly == nil) then
		return nil, nil
	end

	local meters = math.sqrt(min_distance_sqr)

	if (meters > 20) then
		return nil, meters
	end

	return closest_anomaly, meters
end

function artefact_merger_ui:CheckClosestAnomaly(item_section)
	if (self.closest_anomaly) then
		if (self.closest_anomaly:can_spawn_artefact(item_section)) then
			return true
		else
			SetHudMsg(strtransl("ui_st_anomaly_doesnt_fit"),5)
			return false
		end
	else
		SetHudMsg(strtransl("ui_st_too_far_from_anomaly"),5)
		return false
	end

    return false
end