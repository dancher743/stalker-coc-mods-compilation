--
-- Returner item
-- Implementation: Dancher
-- Original idea: Cumulative Pack mod
--

local item_section = "returner"
local point_spot_name = "returner_point_spot"
local point_distance_range_sqr = 30 * 30
local cooldown = 1800
local cooldown_timer_id = "returner_teleport_cooldown"
local pp_delay = 400
local pp_delay_timer_id = "pp_delay_timer"

local point_id = nil
local se_point = nil

local function give_set_position_news()
	local caption = strtransl(news_manager.get_inv_name(item_section))
	local text = strtransl("st_item_returner_position_set_news")
	local icon = "ui_iconsTotal_locations"
	news_helper.give_news(caption, text, icon)
end

local function get_position()
	if (point_id == nil) then
		return nil
	end

	se_point = alife_object(point_id)

	return se_point.position
end

local function set_position()
	local sim = alife()
	local actor = db.actor
	local position = db.actor:position()

	if (se_point == nil) then
		if (point_id == nil) then
			se_point = sim:create("returner_point_object", position, actor:level_vertex_id(), actor:game_vertex_id())
			point_id = se_point.id
			level.map_add_object_spot_ser(point_id, point_spot_name, strtransl("st_item_returner_position_spot_descr"))
			give_set_position_news()
			return
		end

		se_point = alife_object(point_id)
	end

	sim:teleport_object(point_id, actor:game_vertex_id(), actor:level_vertex_id(), position)
	give_set_position_news()
end

local function remove_position()
	if (point_id == nil) then
		return
	end

	if (se_point == nil) then
		se_point = alife_object(point_id)
	end

	if (level.map_has_object_spot(point_id, point_spot_name) == 1) then
		level.map_remove_object_spot(point_id, point_spot_name)
	end

	safe_release_manager.release(se_point)

	point_id = nil
	se_point = nil
end

local function actor_on_item_use(obj)
	if (obj:section() ~= item_section) then
		return
	end

	local position = get_position()

	if (position == nil) then
		utils.hide_actor_menu()
		SetHudMsg(strtransl("st_item_returner_position_not_set_hudmsg"), 5)
		return
	end

	local actor = db.actor
	local dist_to_actor_sqr = position:distance_to_sqr(actor:position())

	if (dist_to_actor_sqr > point_distance_range_sqr) then
		utils.hide_actor_menu()
		SetHudMsg(strtransl("st_item_returner_position_too_far_hudmsg"), 5)
		return
	end

	if (HasTimer(cooldown_timer_id)) then
		SetHudMsg(strtransl("st_item_returner_not_ready_hudmsg"), 5)
		return
	end
	
	SetHudMsg(STR_EMPTY, 0)
	
	xr_effects.disable_actor_nightvision()
    level.add_pp_effector("teleport.ppe", 2006, false)
    xr_sound.play_sound_by_path("anomaly\\teleport_work_1", false)

	local function tickback1()
		StopTimer(pp_delay_timer_id)
		actor:set_actor_position(position)
	end
	StartTimer(pp_delay_timer_id, pp_delay, tickback1)

	local function tickback2()
		StopTimer(cooldown_timer_id)
	end
	StartTimer(cooldown_timer_id, cooldown, tickback2)
end

local function save_state(data)
	if (data.item_returner == nil) then
		data.item_returner = {}
	end	
	data.item_returner.point_id = point_id
end

local function load_state(data)
	if (data.item_returner) then
		point_id = data.item_returner.point_id or point_id
	end
end

function on_game_start()
	RegisterScriptCallback("actor_on_item_use",actor_on_item_use)
	RegisterScriptCallback("save_state",save_state)
	RegisterScriptCallback("load_state",load_state)
end

function set_position_functor()
	return strtransl("st_item_returner_set_position")
end

function remove_position_functor()
	return strtransl("st_item_returner_remove_position")
end

function set_position_action_functor()
	set_position()
end

function remove_position_action_functor()
	remove_position()
end