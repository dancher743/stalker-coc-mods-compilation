--
-- Offline Alife for non-EOC mode squads
-- Added by Dancher
-- Special thanks to offline alife of AMK, EOC and Anomaly!
--

local dbg = DEV_DEBUG

local combats_per_level = 5
local map_combat_chance = 20
local map_combat_min_distance = 10*10
local map_combat_max_distance = 50*50
local map_combat_avoid_chance = 20
local power_handicap_chance = 25
local power_handicap_multipliers = { 1, 1.5, 2, 3 }
local rank_points_for_kill = 20

local rank_power = {
	["novice"] = 10,
	["trainee"] = 20,
	["experienced"] = 30,
	["professional"] = 40,
	["veteran"] = 50,
	["expert"] = 60,
	["master"] = 70,
	["legend"] = 80,
	-- monsters
	["weak"] = 30,
	["normal"] = 60,
	["strong"] = 90
}

local loot_ignore_list = {
		["bolt"] = true,
		["device_torch"] = true,
		["device_pda"] = true,
		["wpn_binoc"] = true,
		["medkit_script"] = true,
		["guitar_a"] = true,
		["harmonica_a"] = true,
		["anim_binoc"] = true,
		["anim_knife"] = true,
		["hand_radio"] = true,
		["hand_radio_r"] = true,
		["stick_bred"] = true,
		["stick_kolbasa"] = true,
		["stick_kolbasa_bred"] = true,
		["wpn_knife"] = true
}

local is_initialized
local loot_items
local update_timer
local update_queue_timer
local combat_squads_table
local combat_squads_level_ids_shuffled
local processed_squads
local combats_queue
local last_victim_stalker_id
local last_killer_stalker_id
local is_survival_mode
local actor_level_id
local se_obj_cache

local msg_format
local function printf_dbg(msg,...)
	if (msg_format == nil) then
		msg_format = "### Offline Combat: %s ###"
	end
	msg = strformat(msg_format, msg)
	printf(msg,...)
end

local function is_on_actor_level(obj)
	local level_id = simulation_objects.get_level_id(obj)
	return level_id and level_id == actor_level_id
end

local function calculate_npc_power(id)
	local power = 0
	local se_obj = se_obj_cache:get(id)
	if (se_obj) then
		local rank_name = ranks.get_se_obj_rank_name(se_obj)
		power = power + (rank_power[rank_name] or 0)
	end
	if (has_chance(power_handicap_chance)) then
		power = power * utils.random_in_itable(power_handicap_multipliers)
	end
	return power
end

local function calculate_squad_power(squad)
	local power = 0
	for k in squad:squad_members() do
		power = power + calculate_npc_power(k.id)
	end
	return power
end

local function relocate_loot(is_killer_stalker, is_victim_stalker, killer_community, se_killer, se_victim)
	if (not is_killer_stalker or killer_community == community.zombied) then
		return
	end

	if (not is_victim_stalker and loot_items[se_killer.id]) then
		local killer_items = loot_items[se_killer.id]
		local t = {}
		itms_manager.loot_mutant_se(se_victim:clsid(),t,se_killer)
		for _,v in pairs(t) do
			for _,id in ipairs(v) do
				table.insert(killer_items, id)
			end
		end
		utils.se_obj_save_var(se_victim.id,STR_EMPTY,"looted",true)
		return
	end

	if (not loot_items[se_victim.id] or not loot_items[se_killer.id]) then
		return
	end

	local victim_items = loot_items[se_victim.id]

	for i = #victim_items, 1, -1 do
		local victim_item = se_obj_cache:get(victim_items[i])

		if (victim_item == nil or victim_item.parent_id == 0 or victim_item.parent_id == 65535) then
			table.remove(victim_items, i)
		elseif (victim_item.parent_id == se_victim.id) then
			table.remove(victim_items, i)
			local killer_items = loot_items[se_killer.id]

			if (killer_items) then
				local killer_item = create_item_se(victim_item:section_name(), se_killer)
				table.insert(killer_items, killer_item.id)
				-- if dbg then printf_dbg("loot relocated!") end
			end

			safe_release_manager.release(victim_item)
		end
	end
	
	loot_items[se_victim.id] = nil
	utils.se_obj_save_var(se_victim.id,STR_EMPTY,"dont_spawn_loot",true)
end

-- from Anomaly 1.5.1.2
local killer_squad_ids = {}
local victim_squad_ids = {}

local function execute_kill(se_killer, se_victim, killer_squad, victim_squad)
	local is_killer_stalker = killer_squad:is_stalker()
	local is_victim_stalker = victim_squad:is_stalker()
	local killer_community = killer_squad:get_squad_community()
	
	if (is_killer_stalker and is_victim_stalker) then
		game_relations.drx_df_faction_npc_on_death(victim_squad:get_squad_community(), killer_community)
	end
	
	if (is_killer_stalker) then
		se_killer:set_rank(se_killer:rank() + rank_points_for_kill)
	end
	
	relocate_loot(is_killer_stalker, is_victim_stalker, killer_community, se_killer, se_victim)
	
	se_victim:on_death(se_killer)
end

local function execute_combat_on_map(squad1, squad2)
	iempty_table(killer_squad_ids)
	iempty_table(victim_squad_ids)
	
	for k in squad1:squad_members() do
		table.insert(killer_squad_ids, k.id)
	end
	
	for k in squad2:squad_members() do
		table.insert(victim_squad_ids, k.id)
	end
	
	utils.shuffle_itable(killer_squad_ids)
	utils.shuffle_itable(victim_squad_ids)

	local se_killer_id = nil
	local se_victim_id = nil
	local is_victim_stalker = false
	
	for i = #killer_squad_ids, 1, -1 do
		local squad1_npc_id = killer_squad_ids[i]
		local squad1_npc = se_obj_cache:get(squad1_npc_id)
		
		if (squad1_npc) then
			local squad1_npc_power = calculate_npc_power(squad1_npc_id)

			for j = #victim_squad_ids, 1, -1 do
				local squad2_npc_id = victim_squad_ids[j]
				local squad2_npc = se_obj_cache:get(squad2_npc_id)
				
				if (squad2_npc) then
					local squad2_npc_power = calculate_npc_power(squad2_npc_id)
					local se_killer = nil
					local se_victim = nil
					local killer_squad = nil
					local victim_squad = nil
					local can_execute_kill = false
					
					if (squad1_npc_power > squad2_npc_power) then
						se_killer = squad1_npc
						se_victim = squad2_npc
						killer_squad = squad1
						victim_squad = squad2
						can_execute_kill = true
						if dbg then printf_dbg("%s(%s) kills %s(%s) (%s)(map)", squad1_npc:name(), squad1_npc_power, squad2_npc:name(), squad2_npc_power, simulation_objects.get_level_name(squad1_npc)) end
					elseif (squad1_npc_power < squad2_npc_power) then
						se_killer = squad2_npc
						se_victim = squad1_npc
						killer_squad = squad2
						victim_squad = squad1
						can_execute_kill = true
						if dbg then printf_dbg("%s(%s) kills %s(%s) (%s)(map)", squad2_npc:name(), squad2_npc_power, squad1_npc:name(), squad1_npc_power, simulation_objects.get_level_name(squad2_npc)) end
					elseif (squad1_npc_power == squad2_npc_power) then
						if dbg then printf_dbg("%s(%s) tie %s(%s) (%s)(map)", squad1_npc:name(), squad1_npc_power, squad2_npc:name(), squad2_npc_power, simulation_objects.get_level_name(squad1_npc)) end
					end

					if (can_execute_kill) then
						if (has_chance(map_combat_avoid_chance) == false) then
							is_victim_stalker = victim_squad:is_stalker()
							se_victim_id = se_victim.id
							se_killer_id = se_killer.id
							execute_kill(se_killer, se_victim, killer_squad, victim_squad)
						end

						if (se_victim.id == squad1_npc_id) then
							table.remove(killer_squad_ids, i)
						elseif (se_victim.id == squad2_npc_id) then
							table.remove(victim_squad_ids, j)
						end

						break
					end
				else
					table.remove(victim_squad_ids, j)
				end
			end

			if (#killer_squad_ids == 0 or #victim_squad_ids == 0) then
				break
			end

		else
			table.remove(killer_squad_ids, i)
		end
	end
	
	return is_victim_stalker, se_victim_id, se_killer_id
end

local function prepare_combats(squads)
	local squads_count = #squads
	
	if (squads_count == 0) then
		return
	end
	
	local combats_count = 0
	
	for i=1,squads_count do
		local squad1 = squads[i]
		
		if (squad1 and not processed_squads[squad1.id]) then
			for j=1,squads_count do
				local squad2 = squads[j]
				
				if (squad2 and squad1.id ~= squad2.id and not processed_squads[squad2.id] and 
					simulation_objects.is_on_the_same_level(squad1, squad2) and 
					(is_on_actor_level(squad1) == false and is_on_actor_level(squad2) == false)) 
				then
					local community1 = squad1:get_squad_community()
					local community2 = squad2:get_squad_community()
					local are_enemies = nil
					
					if (is_survival_mode and sim_survival_mode.are_factions_zombied_and_monster(community1, community2)) then
						-- from Survival-EOC
						are_enemies = false
					else
						are_enemies = game_relations.is_factions_enemies(community1, community2)
					end
					
					if (are_enemies) then
						local can_combat = false

						if (squad1.current_target_id == nil and squad2.current_target_id == nil and has_chance(map_combat_chance)) then
							local squads_distance = squad2.position:distance_to_sqr(squad1.position)
							can_combat = squads_distance >= map_combat_min_distance and squads_distance <= map_combat_max_distance
						end

						if (can_combat) then
							table.insert(combats_queue, {squads, i, j})
							processed_squads[squad1.id] = true
							processed_squads[squad2.id] = true
							if dbg then printf_dbg("added to queue: %s, %s", squad1:name(), squad2:name()) end
							combats_count = combats_count + 1
							break
						end
					end
				end
			end
		end
		
		if (combats_count == combats_per_level) then
			break
		end
	end
	
	empty_table(processed_squads)
end

local function is_item_valid(se_item)
	local parent_id = se_item.parent_id
	if (parent_id == nil or parent_id == 0 or parent_id == 65535) then
		return false
	end
	
	local section = se_item:section_name()
	if (loot_ignore_list[section] == true) then
		return false
	end
	
	if (get_object_story_id(se_item.id) ~= nil) then
		return false
	end
	
	local se_parent = alife_object(parent_id)
	if not (se_parent and IsStalker(se_parent)) then
		return false
	end
	
	return true
end

local function is_squad_valid(squad)
	if (not squad:alive() or 
		get_object_story_id(squad.id) or 
		xrs_kill_wounded.hostage_list[squad:commander_id()]) 
	then
		return false
	end
	
	local task_info = task_manager.get_task_manager().task_info
	
	for k in squad:squad_members() do
		if (axr_task_manager.bounties_by_id) then
			for _,npc_id in pairs(axr_task_manager.bounties_by_id) do
				if (npc_id == k.id) then
					return false
				end
			end
		end
		
		local se_obj = alife_object(k.id)
		
		if (se_obj == nil or se_obj.group_id == 65535) then
			return false
		end
		
		for _,task in pairs(task_info) do
			local giver_id = task.task_giver_id
			if (se_obj and giver_id and (giver_id == se_obj.group_id or giver_id == se_obj.id)) then
				return false
			end
		end
		
		if (se_obj and axr_companions.is_invulnerable(se_obj)) then
			return false
		end
    end
	
	return true
end

local function update_queue()
	if (#combats_queue == 0) then
		return
	end
	
	local combat = combats_queue[1]
	table.remove(combats_queue, 1)
	
	local squads = combat[1]
	local squad1_index = combat[2]
	local squad2_index = combat[3]
	local squad1 = squads[squad1_index]
	local squad2 = squads[squad2_index]
	
	if (squad1 == nil or squad2 == nil or 
		squad1:alive() == false or squad2:alive() == false or 
		squad1.online or squad2.online) then
		return
	end
	
	local is_victim_stalker, victim_id, killer_id = execute_combat_on_map(squad1, squad2)
	
	if (squad1:npc_count() == 0) then
		squads[squad1_index] = nil
	end
	
	if (squad2:npc_count() == 0) then
		squads[squad2_index] = nil
	end
	
	if (is_victim_stalker) then
		last_victim_stalker_id = victim_id
		last_killer_stalker_id = killer_id
	end
end

local function fill_combat_squads_table()
	combat_squads_table = {}
	
	for _,squad in pairs(SIMBOARD.squads) do
		if (squad and squad.first_update and squad.online == false and is_squad_valid(squad)) then
			local level_id = simulation_objects.get_level_id(squad)
			local combat_squads = nil
			
			if (combat_squads_table[level_id] == nil) then
				combat_squads = sim_squad_offline_combat.combat_squads(level_id)
				combat_squads_table[level_id] = combat_squads
			else
				combat_squads = combat_squads_table[level_id]
			end
			
			table.insert(combat_squads.squads, squad)
		end
	end
	
	for _,combat_squads in pairs(combat_squads_table) do
		combat_squads:shuffle()
	end
	combat_squads_level_ids_shuffled = utils.shuffle_table(combat_squads_table)
end

local function fill_loot_items_table()
	loot_items = {}
	
	for i=1,65534 do
		local se_item = alife_object(i)
		if (se_item and is_item_valid(se_item)) then
			local items = nil
			if (loot_items[se_item.parent_id] == nil) then
				items = {}
				loot_items[se_item.parent_id] = items
			else
				items = loot_items[se_item.parent_id]
			end
			table.insert(items, se_item.id)
			-- if dbg then printf_dbg("loot added (%s)", tostring(se_item.id)) end
		end
	end
end

local function remove_loot_items_parent(parent_id)
	if not (loot_items and loot_items[parent_id]) then
		return
	end

	loot_items[parent_id] = nil
end

local function remove_loot_item(se_item)
	local parent_id = se_item.parent_id
	if not (loot_items and loot_items[parent_id]) then
		return
	end

	local items = loot_items[se_item.parent_id]

	for i = #items, 1, -1 do
		if (items[i] == se_item.id) then
			table.remove(items, i)
			break
		end
	end
end

local function update()
	if (combat_squads_table == nil) then
		fill_combat_squads_table()
	end
	
	if (loot_items == nil) then
		fill_loot_items_table()
	end
	
	local level_to_update = nil
	
	for _,level_id in pairs(combat_squads_level_ids_shuffled) do
		local combat_squads = combat_squads_table[level_id]
		if (level_id ~= actor_level_id and combat_squads.were_combats == false) then
			level_to_update = level_id
			break
		end
	end
	
	if (level_to_update == nil) then
		combat_squads_table = nil
		combat_squads_level_ids_shuffled = nil
		loot_items = nil
		if dbg then printf_dbg("restart combats") end
		return
	end
	
	local combat_squads = combat_squads_table[level_to_update]
	
	prepare_combats(combat_squads.squads)
	if dbg then printf_dbg("process combats") end
	
	combat_squads.were_combats = true
end

local function actor_on_update(_,delta)
	update_timer = update_timer - delta
	if (update_timer <= 0) then
		update()
		update_timer = math.random(10000,15000)
		return
	end
	
	update_queue_timer = update_queue_timer - delta
	if (update_queue_timer <= 0) then
		update_queue()
		update_queue_timer = 1500
		return
	end
end

local function se_obj_on_add_to_safe_release(se_obj)
	se_obj_cache:remove(se_obj.id)
end

local function se_npc_on_unregister(se_obj)
    local id = se_obj.id
    remove_loot_items_parent(id)
    se_obj_cache:remove(id)
end

local function se_item_on_unregister(se_item)
	remove_loot_item(se_item)
    se_obj_cache:remove(se_item.id)
end

local function save_state(data)
	if (not data.offline_combat) then
		data.offline_combat = {}
	end
	data.offline_combat.last_victim_stalker_id = last_victim_stalker_id
	data.offline_combat.last_killer_stalker_id = last_killer_stalker_id
end

local function load_state(data)
	if (not data.offline_combat) then
		return
	end
	last_victim_stalker_id = data.offline_combat.last_victim_stalker_id
	last_killer_stalker_id = data.offline_combat.last_killer_stalker_id
end

local function initialize()
	if (is_initialized or not is_enabled()) then
		return
	end
	
	processed_squads = {}
	combats_queue = {}
	update_timer = 1000
	update_queue_timer = 0
	is_survival_mode = IsSurvivalMode()
	actor_level_id = game_graph():vertex(alife():actor().m_game_vertex_id):level_id()
	if (se_obj_cache == nil) then
        se_obj_cache = se_object_cache.create()
    end
	RegisterScriptCallback("actor_on_update",actor_on_update)
	RegisterScriptCallback("se_obj_on_add_to_safe_release",se_obj_on_add_to_safe_release)
	RegisterScriptCallback("se_stalker_on_unregister",se_npc_on_unregister)
	RegisterScriptCallback("se_monster_on_unregister",se_npc_on_unregister)
	RegisterScriptCallback("se_item_on_unregister",se_item_on_unregister)
	RegisterScriptCallback("save_state",save_state)
	RegisterScriptCallback("load_state",load_state)
	
	is_initialized = true
	if dbg then printf_dbg("initialized") end
end

local function finalize()
	if (not is_initialized) then
		return
	end
	
	combat_squads_table = nil
	loot_items = nil
	pop_last_killed_stalker_data()
	
	UnregisterScriptCallback("actor_on_update",actor_on_update)
	UnregisterScriptCallback("se_obj_on_add_to_safe_release",se_obj_on_add_to_safe_release)
	UnregisterScriptCallback("se_stalker_on_unregister",se_npc_on_unregister)
	UnregisterScriptCallback("se_monster_on_unregister",se_npc_on_unregister)
	UnregisterScriptCallback("se_item_on_unregister",se_item_on_unregister)
	UnregisterScriptCallback("save_state",save_state)
	UnregisterScriptCallback("load_state",load_state)
	processed_squads = nil
	combats_queue = nil
	update_timer = nil
	update_queue_timer = nil
	is_survival_mode = nil
	actor_level_id = nil
	se_obj_cache:clear()
	
	is_initialized = false
	if dbg then printf_dbg("finalized") end
end

local function on_game_load()
	initialize()
end

function on_game_start()
	RegisterScriptCallback("on_game_load",on_game_load)
end

function option_on_accept(value)
	if (value) then
		initialize()
	else
		finalize()
	end
end

function is_enabled()
	return not IsEocMode() and axr_main_options.get_check_option("offline_combat")
end

function pop_last_killed_stalker_data()
	local victim_id = last_victim_stalker_id
	local killer_id = last_killer_stalker_id
	
	last_victim_stalker_id = nil
	last_killer_stalker_id = nil
	
	return victim_id, killer_id
end

class "combat_squads"
function combat_squads:__init(level_id)
	self.level_id = level_id
	self.squads = {}
	self.were_combats = false
end

function combat_squads:shuffle()
	utils.shuffle_itable(self.squads)
end