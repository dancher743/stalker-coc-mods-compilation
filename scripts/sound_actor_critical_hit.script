--
-- Sound for Critical Hit
-- Added by Dancher
--

local volume = 0.3
local sound_paths = {
	"actor\\hurt2",
	"actor\\hurt3",
	"actor\\hurt5",
	"actor\\hurt6",
	"actor\\hurt7"
}

local function get_sound()
	local sound_path = sound_paths[math.random(#sound_paths)]
	local sound = xr_sound.get_safe_sound_object(sound_path)
	return sound
end

function play_sound_on_distance(obj_position)
	local sound = get_sound()
	if (sound == nil or sound:playing() == true) then
		return
	end
	sound:play_no_feedback(db.actor, sound_object.s2d, 0, VEC_ZERO, volume)
end
