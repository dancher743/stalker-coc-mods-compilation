-- if return game_object then it ignores engine. If return nil, then engine tries to find item to kill
-- called from engine!
function update_best_weapon(npc,cur_wpn)
	return ai_stalker_weapon.update_best_weapon(npc,cur_wpn)
end

-- called from engine!
function update_best_outfit(npc,cur_outfit)
	return ai_stalker_outfit.update_best_outfit(npc,cur_outfit)
end
